# Optional relay. Without one, guests only get a STUN server: they cannot join from
# networks that block direct connections, and the host sees their IP address.
# Either Cloudflare's TURN service (dashboard: Realtime > TURN Server)...
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# ...or a TURN server of your own (coturn with use-auth-secret, see docs/DEPLOIEMENT.md).
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=

# The address people open. In local development, Vite serves the site on 5173.
PUBLIC_URL=http://localhost:5173

# "on" lists public rooms. Keep it off in production until moderation is staffed.
PUBLIC_ROOMS=on

# Account ids (see /api/me) of the people who handle reports, comma-separated.
ADMIN_USER_IDS=

# Sign-in providers, each optional. Redirect URL to register with the provider:
#   <PUBLIC_URL>/api/auth/<discord|google>/callback
# Discord: https://discord.com/developers/applications > OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
