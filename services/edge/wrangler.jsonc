{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couchwarp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "couchwarp",
      // Created with `wrangler d1 create couchwarp --location weur`.
      "database_id": "7b48a919-73f0-4405-a4a0-1c2614f397f9",
      "migrations_dir": "migrations"
    }
  ],
  // Public settings. Secrets (sign-in, relay, admins) are set with `wrangler secret put`.
  "vars": {
    "PUBLIC_URL": "https://couchwarp.sachapastor34.workers.dev",
    // "on" opens the public game list. Reports are handled on /moderation.
    "PUBLIC_ROOMS": "on",
    // The desktop app's releases, for updates and downloads (src/updates.ts). While the
    // repository is private, RELEASES_TOKEN (a read-only token) lets the server read them.
    "RELEASES_REPO": "kiy0ni/couchwarp"
  },
  // The daily clean-up (src/cleanup.ts), at a quiet hour.
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
