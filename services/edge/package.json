{
  "name": "@couchwarp/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply couchwarp --local",
    "db:migrate:remote": "wrangler d1 migrations apply couchwarp --remote"
  },
  "dependencies": {
    "@couchwarp/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "vitest": "5.1.1",
    "wrangler": "4.163.0"
  }
}
