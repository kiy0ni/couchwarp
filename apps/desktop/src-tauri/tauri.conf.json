{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Couchwarp",
  "mainBinaryName": "Couchwarp",
  "version": "0.2.1",
  "identifier": "app.couchwarp.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://couchwarp.sachapastor34.workers.dev"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": ["site"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MTIxMjY0MUU0RTI0OUEKUldTYUpFNGVaQklTSlpuQVBMdWx6dzh6bkRqVjBJc3dlaWRxSnZUaXF1eC9iNXJ4WUgyTjBHVksK",
      "endpoints": ["https://couchwarp.sachapastor34.workers.dev/api/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "category": "Game",
    "shortDescription": "Play your PC games with friends who join from a browser",
    "publisher": "Sacha Pastor",
    "copyright": "Sacha Pastor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["pulseaudio-utils"]
      }
    }
  }
}
