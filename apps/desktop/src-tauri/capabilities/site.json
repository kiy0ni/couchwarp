{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "site",
  "description": "What the Couchwarp site may ask the app, from its own address only.",
  "windows": ["main", "bubble"],
  "remote": {
    "urls": ["https://couchwarp.sachapastor34.workers.dev/*", "http://localhost:5173/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "allow-list-windows",
    "allow-window-preview",
    "allow-hosting-state",
    "allow-start-hosting",
    "allow-stop-hosting",
    "allow-saved-session",
    "allow-sign-in",
    "allow-sign-out",
    "allow-save-session",
    "allow-input-allowed",
    "allow-restart-app",
    "allow-controller-support",
    "allow-install-controller-support",
    "allow-repair-permission",
    "allow-open-privacy-settings",
    "allow-set-bubble-open",
    "allow-show-main-window",
    "allow-update-available",
    "allow-install-update"
  ]
}
